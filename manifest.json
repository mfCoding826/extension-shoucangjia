{
  "manifest_version": 3,
  "name": "智能收藏夹",
  "version": "1.0.0",
  "description": "自动识别书签页面类型并生成摘要，同步到飞书多维表格",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "bookmarks",
    "storage",
    "scripting",
    "notifications",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options/options.html",
  "action": {
    "default_title": "智能收藏夹 · 点击打开设置"
  }
}
